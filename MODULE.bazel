bazel_dep(name = "rules_cc", version = "0.2.2")
bazel_dep(name = "platforms", version = "0.0.11")
bazel_dep(name = "pkg-config", version = "0.29.2")
bazel_dep(name = "bazel_skylib", version = "1.8.1")

bazel_dep(name = "toolchains_llvm", version = "1.5.0")

# compile_commands.json generation for clangd
bazel_dep(name = "hedron_compile_commands", dev_dependency = True)
git_override(
    module_name = "hedron_compile_commands",
    remote = "https://github.com/hedronvision/bazel-compile-commands-extractor.git",
    commit = "4f28899228fb3ad0126897876f147ca15026151e",
)

# Load your custom rule

#llvm_config_repo = use_repo_rule("//:llvm_config_repo.bzl", "llvm_config_repo")
#llvm_config_repo(name = "llvm")

# Configure and register the toolchain.
llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(
    llvm_version = "21.1.0",
)

toolchain = use_repo(llvm, "llvm_toolchain")
register_toolchains("@llvm_toolchain//:all")

llvm.sysroot()
