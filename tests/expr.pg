Expr ::= Equality
Expr ::= Expr && Equality
Expr ::= Expr || Equality

Equality ::= Sum
Equality ::= Sum > Sum
Equality ::= Sum == Sum
Equality ::= Sum < Sum

Sum ::= Product
Sum ::= Sum + Product
Sum ::= Sum - Product

Product ::= Unary
Product ::= Product * Unary
Product ::= Product / Unary

Unary ::= Term
Unary ::= ! Term
Unary ::= - Term

Term ::= INT
Term ::= IDENT
Term ::= ( Expr )